            <column caption='AOV Uplift' datatype='real' default-format='n&quot;+ &quot;#,##0.00&quot; x&quot;;-&quot;+ &quot;#,##0.00&quot; x&quot;' name='[Calculation_1512646539997446155]' role='measure' type='quantitative'>
