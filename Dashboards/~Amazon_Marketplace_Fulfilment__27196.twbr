    <worksheet name='Category Portfolio (Orders vs Revenue)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Book' fontsize='10'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Book' fontsize='8'>Category Strategy (Hover to explore)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_data' name='federated.0vvw2uh1ekou1f1g7pccm0pomwk7' />
          </datasources>
          <datasource-dependencies datasource='federated.0vvw2uh1ekou1f1g7pccm0pomwk7'>
            <column caption='Portfolio Strategy' datatype='string' name='[Calculation_1233141888065007638]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([amount]) &gt;= 20000000&#13;&#10;AND COUNTD([order_id]) &gt;= 25000 THEN&#13;&#10;    &quot;Winner — Scale &amp; Protect&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([amount]) &gt;= 8000000&#13;&#10;AND COUNTD([order_id]) &gt;= 10000 THEN&#13;&#10;    &quot;Premium — Targeted Push&quot;&#13;&#10;&#13;&#10;ELSEIF COUNTD([order_id]) &gt;= 10000&#13;&#10;AND SUM([amount]) &lt; 8000000 THEN&#13;&#10;    &quot;Volume Trap — Move to Value&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Catalogue Waste — Rationalize&quot;&#13;&#10;END' />
            </column>
            <column caption='Amount' datatype='real' default-format='n#,##0;-#,##0' name='[amount]' role='measure' type='quantitative' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column-instance column='[order_id]' derivation='CountD' name='[ctd:order_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column-instance column='[amount]' derivation='Sum' name='[sum:amount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1233141888065007638]' derivation='User' name='[usr:Calculation_1233141888065007638:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <manual-sort column='[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[usr:Calculation_1233141888065007638:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Catalogue Waste — Rationalize&quot;</bucket>
              <bucket>&quot;Premium — Targeted Push&quot;</bucket>
              <bucket>&quot;Volume Trap — Move to Value&quot;</bucket>
              <bucket>&quot;Winner — Scale &amp; Protect&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[sum:amount:qk]' field-type='quantitative' max='50000000.0' min='-2764726.8679555687' range-type='fixed' scope='cols' type='space' />
