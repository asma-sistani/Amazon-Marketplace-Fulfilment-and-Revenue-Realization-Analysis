            </column>
            <column caption='Promo_Revenue_pct' datatype='real' default-format='p0.0%' name='[Promo_Orders_pct (copy)_1512646539982770180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [promotion_ids] &lt;&gt; &quot;No Promotion&quot; THEN [amount] END&#13;&#10;)&#13;&#10;/ SUM([amount])' />
