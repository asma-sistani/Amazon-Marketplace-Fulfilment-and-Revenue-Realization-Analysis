      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[ctd:order_id:qk]&quot;' value='Total Orders' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[ctd:sku:qk]&quot;' value='Total SkUs' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[sum:amount:qk]&quot;' value='Total Revenue' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[sum:Calculation_1233141888009265170:qk]&quot;' value='Low-rotation' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[sum:Calculation_1233141888013111315:qk]&quot;' value='Dead SKUs' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[usr:Calculation_1233141887596883968:qk]&quot;' value='Average Order Value' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[usr:Calculation_1233141887598809091:qk]&quot;' value='Median Order Value' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[usr:Calculation_1233141888014114836:qk]&quot;' value='Top-2 Share' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[usr:Calculation_1512646539978878977:qk]&quot;' value='Promo Order Share' />
          <alias key='&quot;[federated.0vvw2uh1ekou1f1g7pccm0pomwk7].[usr:Promo_Orders_pct (copy)_1512646539982770180:qk]&quot;' value='Promo Revenue Share' />
        </aliases>
      </column>
      <column caption='AOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1233141887596883968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amount])/COUNTD([order_id])' />
      </column>
      <column caption='MOV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1233141887598809091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN({ FIXED [order_id] : SUM([amount]) })' />
      </column>
      <column caption='Amazon Unrealized Revenue(%)' datatype='real' default-format='p0.0%' name='[Calculation_1233141887599841285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [fulfilment] = &apos;Amazon&apos;&#13;&#10;        AND (&#13;&#10;            [order_status] = &quot;cancelled&quot;&#13;&#10;            OR [order_status] = &quot;in_progress&quot;&#13;&#10;            OR [order_status] = &quot;returned&quot;&#13;&#10;        )&#13;&#10;        THEN [amount]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;/ { FIXED : SUM([amount]) }' />
      </column>
      <column caption='one' datatype='integer' name='[Calculation_1233141887611469830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Low_rotation_pct' datatype='real' default-format='p0.00%' name='[Calculation_1233141888009265170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD(&#13;&#10;      IF [low_rotation_flag] = 1 THEN [sku] END&#13;&#10;  ) }/{ FIXED : COUNTD([sku]) }' />
      </column>
      <column caption='Dead_SKUs_pct' datatype='real' default-format='p0.00%' name='[Calculation_1233141888013111315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD(&#13;&#10;      IF [dead_flag] = 1 THEN [sku] END&#13;&#10;  ) }/{ FIXED : COUNTD([sku]) }' />
      </column>
      <column caption='Top2_Share_pct' datatype='real' default-format='p0.00%' name='[Calculation_1233141888014114836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM( IF [Category Set] THEN [amount] END )&#13;&#10;/&#13;&#10;SUM([amount]))' />
      </column>
      <column caption='sku_segment' datatype='string' name='[Calculation_1233141888022011925]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dead_flag] = 1 THEN &quot;Dead&quot;&#13;&#10;ELSEIF [low_rotation_flag] = 1 THEN &quot;Low-rotation&quot;&#13;&#10;ELSE &quot;Healthy&quot;&#13;&#10;END' />
      </column>
      <column caption='Portfolio Strategy' datatype='string' name='[Calculation_1233141888065007638]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([amount]) &gt;= 20000000&#13;&#10;AND COUNTD([order_id]) &gt;= 25000 THEN&#13;&#10;    &quot;Winner — Scale &amp; Protect&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([amount]) &gt;= 8000000&#13;&#10;AND COUNTD([order_id]) &gt;= 10000 THEN&#13;&#10;    &quot;Premium — Targeted Push&quot;&#13;&#10;&#13;&#10;ELSEIF COUNTD([order_id]) &gt;= 10000&#13;&#10;AND SUM([amount]) &lt; 8000000 THEN&#13;&#10;    &quot;Volume Trap — Move to Value&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Catalogue Waste — Rationalize&quot;&#13;&#10;END' />
      </column>
      <column caption='Promo_Flag' datatype='integer' name='[Calculation_1512646539978293248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [order_id] :&#13;&#10;    MAX( IIF( [promotion_ids] &lt;&gt; &quot;No Promotion&quot;, 1, 0 ) )&#13;&#10;}' />
      </column>
      <column caption='Promo_Orders_pct' datatype='real' default-format='p0.00%' name='[Calculation_1512646539978878977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [promotion_ids] &lt;&gt; &quot;No Promotion&quot; THEN [order_id] END&#13;&#10;)&#13;&#10;/ COUNTD([order_id])' />
      </column>
      <column caption='Promo_AOV' datatype='real' name='[Calculation_1512646539983716357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Promo_Orders (copy)_1512646539982635011]/[Promo_Flag (copy)_1512646539982282754]' />
      </column>
      <column caption='AOV Uplift' datatype='real' default-format='n&quot;+ &quot;#,##0.00&quot; x&quot;;-&quot;+ &quot;#,##0.00&quot; x&quot;' name='[Calculation_1512646539997446155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1512646539983716357]/[Promo_AOV (copy)_1512646539992850440])' />
      </column>
      <column caption='Delivered_Revenue' datatype='real' default-format='p0.00%' name='[Calculation_1512646540003282956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;delivered&quot; &#13;&#10;THEN [amount]&#13;&#10;END) / SUM([amount])' />
      </column>
      <column caption='Lost_Revenue' datatype='real' default-format='p0.00%' name='[Calculation_1512646540154970126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [order_status] = &quot;cancelled&quot; &#13;&#10;       OR [order_status] = &quot;returned&quot;&#13;&#10;    THEN [amount] END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([amount])' />
      </column>
      <column caption='Promo_Impact' datatype='real' default-format='n&quot;+ &quot;#,##0.00&quot; x&quot;;-&quot;+ &quot;#,##0.00&quot; x&quot;' name='[Calculation_1512646540196986895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1512646539983716357]/[Promo_AOV (copy)_1512646539992850440]' />
      </column>
      <column datatype='string' name='[Category (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[category]' default='&quot;Other&quot;' new-bin='true'>
          <bin default-name='true' value='&quot;kurta &amp; Set&quot;'>
            <value>&quot;kurta&quot;</value>
            <value>&quot;Set&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Stuck_Revenue' datatype='real' default-format='p0.00%' name='[Delivered_Revenue (copy)_1512646540154482701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;in_progress&quot; &#13;&#10;THEN [amount]&#13;&#10;END) / SUM([amount])' />
      </column>
      <column datatype='string' name='[Order Status (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[order_status]' new-bin='true'>
          <bin default-name='false' value='&quot;Delivered&quot;'>
            <value>&quot;delivered&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Lost&quot;'>
            <value>&quot;cancelled&quot;</value>
            <value>&quot;returned&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Stuck&quot;'>
            <value>&quot;in_progress&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Non_Promo_AOV' datatype='real' name='[Promo_AOV (copy)_1512646539992850440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Calculation_1512646539978293248] = 0 THEN [amount] END )&#13;&#10;/&#13;&#10;COUNTD( IF [Calculation_1512646539978293248] = 0 THEN [order_id] END )' />
      </column>
      <column caption='Promo_Orders' datatype='integer' name='[Promo_Flag (copy)_1512646539982282754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Calculation_1512646539978293248] = 1&#13;&#10; THEN [order_id] END )' />
      </column>
      <column caption='Promo_Revenue' datatype='real' name='[Promo_Orders (copy)_1512646539982635011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1512646539978293248] = 1 THEN [amount] END&#13;&#10;)' />
      </column>
      <column caption='Promo_Revenue_pct' datatype='real' default-format='p0.0%' name='[Promo_Orders_pct (copy)_1512646539982770180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [promotion_ids] &lt;&gt; &quot;No Promotion&quot; THEN [amount] END&#13;&#10;)&#13;&#10;/ SUM([amount])' />
      </column>
      <column caption='Non_Promo_Revenue' datatype='real' name='[Promo_Revenue (copy)_1512646539996741642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_1512646539978293248] = 0 THEN [amount] END&#13;&#10;)' />
      </column>
