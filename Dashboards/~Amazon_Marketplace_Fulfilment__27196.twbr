            <column caption='Promo_Flag' datatype='integer' name='[Calculation_1512646539978293248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [order_id] :&#13;&#10;    MAX( IIF( [promotion_ids] &lt;&gt; &quot;No Promotion&quot;, 1, 0 ) )&#13;&#10;}' />
            </column>
            <column caption='Promo_Orders_pct' datatype='real' default-format='p0.00%' name='[Calculation_1512646539978878977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [promotion_ids] &lt;&gt; &quot;No Promotion&quot; THEN [order_id] END&#13;&#10;)&#13;&#10;/ COUNTD([order_id])' />
            </column>
            <column caption='Promo_AOV' datatype='real' name='[Calculation_1512646539983716357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Promo_Orders (copy)_1512646539982635011]/[Promo_Flag (copy)_1512646539982282754]' />
            </column>
            <column caption='Promo_Impact' datatype='real' default-format='n&quot;+ &quot;#,##0.00&quot; x&quot;;-&quot;+ &quot;#,##0.00&quot; x&quot;' name='[Calculation_1512646540196986895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1512646539983716357]/[Promo_AOV (copy)_1512646539992850440]' />
            </column>
            <column caption='Non_Promo_AOV' datatype='real' name='[Promo_AOV (copy)_1512646539992850440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [Calculation_1512646539978293248] = 0 THEN [amount] END )&#13;&#10;/&#13;&#10;COUNTD( IF [Calculation_1512646539978293248] = 0 THEN [order_id] END )' />
            </column>
            <column caption='Promo_Orders' datatype='integer' name='[Promo_Flag (copy)_1512646539982282754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [Calculation_1512646539978293248] = 1&#13;&#10; THEN [order_id] END )' />
